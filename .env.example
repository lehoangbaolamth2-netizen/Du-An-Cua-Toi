# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ========================================================
# GOOGLE OAUTH 2.0 & AUTHENTICATION CONFIGURATION
# ========================================================
# Lấy từ Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs
# Cấu hình Authorized Javascript Origins:
# - Development: http://localhost:3000
# - Production: https://your-domain.vercel.app (hoặc domain tùy chỉnh của bạn)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Secret key ngẫu nhiên dùng để ký và mã hóa phiên đăng nhập (Session)
AUTH_SECRET="random_secure_hex_secret_min_32_characters"

# ========================================================
# DATABASE & PRODUCTION SETTINGS (VERCEL / CLOUD)
# ========================================================
# Chuỗi kết nối Database (PostgreSQL / SQLite / MongoDB nếu triển khai cloud)
# Mặc định ứng dụng lưu trữ JSON DB bền vững tại server/data_server/db.json
DATABASE_URL="postgresql://user:password@host:5432/nihongoreflex"

# Email của Chủ Quản (Superadmin) được tự động gán quyền cao nhất khi đăng nhập Google
INITIAL_ADMIN_EMAIL="lehoangbaolamth2@gmail.com"
INITIAL_ADMIN_GOOGLE_SUB="109823485720194857201"

# Cổng khởi chạy máy chủ (Mặc định 3000)
PORT=3000
NODE_ENV="development"
